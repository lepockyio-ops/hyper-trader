// OpenClaw 配置片段：4 个 S03 agent 与 hooks。合并进你的 OpenClaw 配置后，用 `openclaw doctor` 检查。
// 键名来自官方文档（2026-10-26 查阅：webhooks、multi-agent-sandbox-tools、subagents）。
// 你的版本若键名不同，以官方文档为准；标了“核对”的地方我没能在文档里找到确切写法。
{
  hooks: {
    enabled: true,
    token: "<与 /etc/s03/openclaw-hooks.env 中 OPENCLAW_HOOKS_TOKEN 相同的专用随机串>",
    path: "/hooks",
    // 只有这三个 agent 能被 webhook 唤醒；s03-research 只由你手动发起
    allowedAgentIds: ["s03-analyst", "s03-ops", "s03-review"],
    allowRequestSessionKey: false,
  },

  // 研究前端：Vibe-Trading 的 MCP 服务器，只给 s03-research 用。
  // v2.2 已用 OpenClaw 2026.10.8 实测（config patch --dry-run 通过、mcp probe 列出 26 个工具、doctor 无相关告警），
  // 记录见 docs/RESEARCH_LAB.md 的“安装验证记录”。
  // 两层限制：toolFilter 只列研究工具；启动命令本身是 fwresearch 的 mcp-guard 白名单代理，交易类工具一律拒绝。
  // MCP 服务器在 Gateway 主机上运行（不在研究沙箱里）。没有安装 /opt/s03/vt-venv 时保持 enabled: false。
  mcp: {
    servers: {
      // BlockBeats（律动）官方 MCP（v2.3）：新闻快讯、文章、搜索、ETF / 稳定币 / 持仓量 / 宏观数据，只给 s03-research 找想法用。
      // 安装：s03-install-blockbeats-mcp（固定 1.0.4，并把上游写死的 http:// 改为 https://）；Key 在 /etc/s03/blockbeats.env。
      // 18 个工具全部是只读 GET；mcp-guard 再按 deploy/openclaw/blockbeats-mcp.allow 放行。新闻正文是外部内容，只进沙箱里的研究 agent。
      "blockbeats": {
        enabled: false,                                     // 装好并填好 Key 后改为 true
        command: "/usr/local/lib/s03/s03-bb-mcp",
        args: [],
        cwd: "/srv/s03-research",
        codex: { agents: ["s03-research"] },
        toolFilter: { include: ["get_*", "search_news"] },
      },
      "vibe-trading": {
        enabled: false,                                     // 装好 Vibe-Trading 后改为 true（install.sh --with-vibe-trading）
        command: "/usr/local/lib/s03/s03-vt-mcp",           // 包装脚本：读 /etc/s03/vibe-trading.env，经 mcp-guard 启动
        args: [],
        cwd: "/srv/s03-research",
        // 不写 codex.agents 时，OpenClaw 会把这个服务器投射给所有 Codex 运行时的 agent（schema 说明，2026.10.8）
        codex: { agents: ["s03-research"] },
        toolFilter: {
          include: ["add_goal_evidence", "alpha_bench", "alpha_zoo", "backtest", "factor_analysis", "get_macro_series",
            "get_market_data", "get_research_goal", "get_run_result", "get_strategy_evidence", "get_swarm_status",
            "list_runs", "list_skills", "list_strategies", "list_swarm_presets", "load_skill", "pattern_recognition",
            "query_strategies", "read_document", "read_run_artifact", "read_url", "run_swarm", "search_symbol",
            "start_research_goal", "update_research_goal_status", "web_search"],
        },
      },
    },
  },

  agents: {
    ownership: "explicit",
    defaults: {
      sandbox: { mode: "off" },
      subagents: {
        model: "<便宜的模型 id>",          // 子 agent 用便宜模型；主 agent 用你的默认模型
        runTimeoutSeconds: 1800,
        maxConcurrent: 4,
        // 嵌套层级：只允许 1 层（主 agent → 子 agent），设置方法见官方 subagents/nesting 文档（核对）
      },
    },
    entries: {
      // 1) 运维：启动、停止、重启 s03 服务，巡检，日报，导出。不派生子 agent。
      "s03-ops": {
        name: "S03 运维",
        workspace: "~/.openclaw/workspace-s03-ops",   // 放 roles/s03-ops.md（作为该工作区的 AGENTS.md）
        sandbox: { mode: "off" },                      // 需要在主机上调用 sudo systemctl；能力由 sudoers 白名单限定
        tools: {
          allow: ["exec", "read", "message"],
          deny: ["vibe-trading__*", "blockbeats__*", "write", "edit", "apply_patch", "process", "browser", "gateway", "sessions_spawn"],
        },
      },

      // 2) 告警分析：由监控进程的告警唤醒；只能查状态和暂停新开仓。不派生子 agent。
      "s03-analyst": {
        name: "S03 告警分析",
        workspace: "~/.openclaw/workspace-s03-analyst",
        sandbox: { mode: "off" },                      // 需要调用主机上的 /usr/local/bin/s03-gate
        tools: {
          allow: ["exec", "message"],
          deny: ["vibe-trading__*", "blockbeats__*", "read", "write", "edit", "apply_patch", "process", "browser", "gateway", "sessions_spawn"],
        },
      },

      // 3) 研究：回测、偏差检查、机器学习验证；可派生子 agent 并行。只在沙箱里的研究副本中工作，无任何密钥。
      "s03-research": {
        name: "S03 研究",
        workspace: "/srv/s03-research",
        sandbox: { mode: "all", scope: "agent", workspaceAccess: "rw" },  // 沙箱镜像需装好 Python 依赖（核对）
        tools: {
          allow: ["vibe-trading__*", "blockbeats__*", "read", "write", "edit", "exec", "sessions_spawn"],   // MCP 工具的规范名是 <服务器>__<工具>（已核对）
          // 研究 agent 跑在沙箱里：沙箱还有一道工具闸门，不放行的话 MCP 工具会在发给模型前被过滤（doctor 实测告警）
          sandbox: { tools: { alsoAllow: ["vibe-trading__*", "blockbeats__*"] } },
          deny: ["process", "browser", "gateway", "message"],
        },
        subagents: { model: "<便宜的模型 id>", allowAgents: ["s03-research"] },   // allowAgents 的取值格式（核对）
      },

      // 4) 复盘：读 inbox 里的日志副本，写周报草稿；可派生子 agent（每个币一个 + 风控、成本角色）。不执行命令。
      "s03-review": {
        name: "S03 复盘",
        workspace: "/srv/s03-review",
        sandbox: { mode: "all", scope: "agent", workspaceAccess: "rw" },
        tools: {
          allow: ["read", "write", "sessions_spawn", "message"],
          deny: ["vibe-trading__*", "blockbeats__*", "exec", "process", "edit", "apply_patch", "browser", "gateway"],
        },
        subagents: { model: "<便宜的模型 id>", allowAgents: ["s03-review"] },
      },
    },
  },
}
