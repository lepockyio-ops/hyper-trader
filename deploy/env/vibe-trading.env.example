# Vibe-Trading 研究用配置（复制为 /etc/s03/vibe-trading.env，root:openclaw 0640）。
# 只放大模型服务的配置；不要放任何交易所 / 钱包 / 券商密钥（mcp-guard 也会把这类变量过滤掉）。
# 不填大模型配置也能用：因子库、行情、读网页等工具不需要；只有 run_swarm（多智能体讨论）需要。
# LANGCHAIN_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LANGCHAIN_MODEL_NAME=
VIBE_TRADING_HOME=/srv/s03-research/.vibe-trading
VIBE_TRADING_ALLOWED_RUN_ROOTS=/srv/s03-research/vt-runs
