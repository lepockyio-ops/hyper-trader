[Unit]
Description=S03 把日志与报告复制到复盘 agent 的收件目录（只读副本）
OnFailure=s03-notify-ops@%n.service

[Service]
Type=oneshot
User=s03trader
Group=s03trader
WorkingDirectory=/var/lib/s03
StateDirectory=s03
Environment=S03_SETTINGS=/etc/s03/settings.toml

ExecStart=/bin/sh -c 'mkdir -p /srv/s03-review/inbox && cp -f var/journal.jsonl /srv/s03-review/inbox/ 2>/dev/null; if [ -d var/reports ]; then cp -rf var/reports /srv/s03-review/inbox/; fi; cp -f /var/lib/s03-events/events.json /srv/s03-review/inbox/ 2>/dev/null; chmod -R g+rX,o-rwx /srv/s03-review/inbox'
TimeoutStartSec=1800
ReadWritePaths=/var/lib/s03 /srv/s03-review/inbox
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
