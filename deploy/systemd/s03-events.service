[Unit]
Description=S03 事件日历：从美联储、BLS、BEA 官方日程生成 events.json（失败时保留上一版并唤醒 s03-ops）
After=network-online.target
Wants=network-online.target
OnFailure=s03-notify-ops@%n.service

[Service]
Type=oneshot
User=s03trader
Group=s03trader
WorkingDirectory=/opt/s03/hl-s03
StateDirectory=s03-events
StateDirectoryMode=0755
EnvironmentFile=/etc/s03/events.env
ExecStart=/opt/s03/venv/bin/python -m s03.events_calendar --out /var/lib/s03-events/events.json
TimeoutStartSec=300
ReadWritePaths=/var/lib/s03-events
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
