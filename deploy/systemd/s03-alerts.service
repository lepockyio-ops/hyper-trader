[Unit]
Description=S03 行情监控与告警（不需要私钥，不消耗 LLM token）
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=s03-notify-ops@%n.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=120
User=s03trader
Group=s03trader
WorkingDirectory=/var/lib/s03
StateDirectory=s03
Environment=S03_SETTINGS=/etc/s03/settings.toml
Environment=PYTHONUNBUFFERED=1
# 只需账户地址（查挂单）和 OpenClaw hooks token
EnvironmentFile=/etc/s03/hl-address.env
EnvironmentFile=/etc/s03/openclaw-hooks.env
ExecStart=/opt/s03/venv/bin/python /opt/s03/hl-s03/scripts/run.py alerts
Restart=always
RestartSec=10
ReadWritePaths=/var/lib/s03
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
