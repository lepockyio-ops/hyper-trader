[Unit]
Description=S-03 OpenClaw 白名单代理（127.0.0.1:8765，只有 status 与 pause）
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=s03-notify-ops@%n.service

[Service]
Type=simple
User=s03trader
Group=s03trader
WorkingDirectory=/var/lib/s03
StateDirectory=s03
Environment=S03_SETTINGS=/etc/s03/settings.toml
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/s03/openclaw-gate.env
ExecStart=/opt/s03/venv/bin/python /opt/s03/hl-s03/scripts/run.py gate
Restart=always
RestartSec=10
ReadWritePaths=/var/lib/s03
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
