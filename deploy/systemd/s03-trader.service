[Unit]
Description=S03 交易主循环（Hyperliquid，每 15 分钟一轮；默认 shadow 模式）
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=s03-notify-ops@%n.service

[Service]
Type=notify
NotifyAccess=main
# 每轮结束与等待期间每 30 秒报一次；一轮卡住超过 20 分钟会被重启
WatchdogSec=1200
User=s03trader
Group=s03trader
WorkingDirectory=/var/lib/s03
StateDirectory=s03
Environment=S03_SETTINGS=/etc/s03/settings.toml
Environment=PYTHONUNBUFFERED=1
# 私钥只在这里加载：root 所有、0600，OpenClaw 用户读不到
EnvironmentFile=/etc/s03/hl-trader.env
ExecStart=/opt/s03/venv/bin/python /opt/s03/hl-s03/scripts/run.py loop
Restart=always
RestartSec=10
ReadWritePaths=/var/lib/s03
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
